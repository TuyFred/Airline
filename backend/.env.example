# ─────────────────────────────────────────────────
#  SBU AIR CARGO — Backend Environment Variables
#  Copy this file to .env and fill in all values.
#  NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────

# ── Server ───────────────────────────────────────
NODE_ENV=production
PORT=5000
# Public-facing URL of the app (no trailing slash)
APP_URL=https://sbuexport.com

# ── Database (cPanel MySQL) ───────────────────────
# In cPanel: MySQL Databases → create DB, user, and grant all privileges
# DB_HOST is always 127.0.0.1 on cPanel (localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cpanelusername_dbuser
DB_PASSWORD=YourStrongDatabasePassword
DB_NAME=cpanelusername_sbu_export_hub

# ── Security ─────────────────────────────────────
# Generate a strong random string: openssl rand -hex 64
JWT_SECRET=replace_with_a_very_long_random_string_at_least_64_chars

# ── Admin bootstrap ──────────────────────────────
# On first startup, this admin account is auto-created if it doesn't exist.
ADMIN_FULL_NAME=System Admin
ADMIN_EMAIL=admin@sbuexport.com
ADMIN_PASSWORD=ChangeThisStrongPassword@2026

# ── Brevo (Email) ────────────────────────────────
# Get from: https://www.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@sbuexport.com
BREVO_SENDER_NAME=SBU Air Cargo

# Support contact (where support emails are sent TO)
SUPPORT_EMAIL=justin@sbuexport.com
BREVO_GMAIL_TO=justin@sbuexport.com

# ── Optional: Company info used in email templates ─
SUPPORT_PHONE=+250788000000
COMPANY_NAME=SBU Air Cargo
EMAIL_LOGO_URL=https://sbuexport.com/logo.png

# ── WhatsApp webhook (optional) ──────────────────
# If you integrate a WhatsApp Business API webhook for lock notices:
# WHATSAPP_WEBHOOK_URL=https://your-whatsapp-provider.com/webhook
